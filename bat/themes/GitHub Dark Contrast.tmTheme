				<string>#F4F4F4</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Built-in Special Variables</string>
			<key>scope</key>
			<string>variable.language, variable.other.builtin</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#79C0FF</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Function / Method Parameters</string>
			<key>scope</key>
			<string>variable.parameter</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#F4F4F4</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Object Properties &amp; Fields</string>
