			<string>variable.other.property, variable.other.object.property, meta.property</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#FF9A44</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Functions &amp; Methods</string>
			<key>scope</key>
			<string>entity.name.function, support.function, meta.function-call</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#B776FC</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Constructors</string>
			<key>scope</key>
			<string>entity.name.type.class.constructor, support.has-constructor</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#7EE787</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Types, Classes &amp; Structs</string>
			<key>scope</key>
			<string>entity.name.type, entity.name.class, entity.name.namespace, support.type, support.class</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#79C0FF</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Labels &amp; Annotations / Attributes</string>
			<key>scope</key>
			<string>entity.name.label, entity.other.attribute-name, meta.attribute</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#FFA657</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Storage &amp; Modifiers</string>
			<key>scope</key>
