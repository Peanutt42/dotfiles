		</dict>

		<!-- ============================================ -->
		<!-- Errors, Diagnostics & TODOs                  -->
		<!-- ============================================ -->
		<dict>
			<key>name</key>
			<string>Invalid / Errors</string>
			<key>scope</key>
			<string>invalid, invalid.illegal</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#F85149</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
