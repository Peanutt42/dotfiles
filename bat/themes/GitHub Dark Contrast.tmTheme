<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>GitHub Dark Contrast</string>

	<key>semanticClass</key>
	<string>theme.dark.github-dark-contrast</string>

	<key>colorSpaceName</key>
	<string>sRGB</string>

	<key>uuid</key>
	<string>E73C4BE2-1227-4DF1-8A02-927C874E1872</string>

	<key>settings</key>
	<array>
		<!-- ============================================ -->
		<!-- Global Editor Settings                       -->
		<!-- ============================================ -->
		<dict>
			<key>settings</key>
			<dict>
				<key>background</key>
				<string>#050505</string>
				<key>foreground</key>
				<string>#FFFFFF</string>
				<key>caret</key>
				<string>#FFFFFF</string>
				<key>lineHighlight</key>
				<string>#151B23</string>
				<key>selection</key>
				<string>#264F78</string>
				<key>selectionBorder</key>
				<string>#1F6FEB</string>
				<key>invisibles</key>
				<string>#2F3337</string>
				<key>guide</key>
				<string>#2F3337</string>
				<key>activeGuide</key>
				<string>#666870</string>
				<key>findHighlight</key>
				<string>#A5D6FF</string>
				<key>findHighlightForeground</key>
				<string>#050505</string>
			</dict>
		</dict>

		<!-- ============================================ -->
		<!-- Basic Syntax Rules                          -->
		<!-- ============================================ -->
		<dict>
			<key>name</key>
			<string>Comments</string>
			<key>scope</key>
			<string>comment, comment.line, comment.block</string>
			<key>settings</key>
			<dict>
				<key>fontStyle</key>
				<string>italic</string>
				<key>foreground</key>
				<string>#8B949E</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Documentation Comments</string>
			<key>scope</key>
			<string>comment.documentation, string.documentation</string>
			<key>settings</key>
			<dict>
				<key>fontStyle</key>
				<string>italic</string>
				<key>foreground</key>
				<string>#D1DAE4</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Strings</string>
			<key>scope</key>
			<string>string, string.quoted, string.template</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#A5D6FF</string>
			</dict>
		</dict>
